from decimal import ROUND_HALF_EVEN, Context, Decimal

from ._decimal import MoneyInput, as_decimal

_CENT = Decimal("0.01")


def round_amount(amount: MoneyInput) -> Decimal:
    value = as_decimal(amount)
    # Local context with enough precision so quantize never fails for
    # large magnitudes, independent of the global decimal context.
    ctx = Context(prec=max(value.adjusted() + 4, 28), rounding=ROUND_HALF_EVEN)
    return value.quantize(_CENT, rounding=ROUND_HALF_EVEN, context=ctx)
