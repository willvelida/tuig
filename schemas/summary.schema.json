{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tuig summary v1",
  "type": "object",
  "required": [
    "schema_version",
    "limitations",
    "claims"
  ],
  "properties": {
    "testTamperAttempts": { "type": "integer", "minimum": 0 },
    "taskVerdict": {
      "type": "object",
      "required": ["verdict", "source"],
      "properties": {
        "verdict": { "enum": ["pass", "fail", "not_evaluated", "infrastructure_error"] },
        "source": { "const": "hidden_oracle" },
        "code": { "type": "string" }
      }
    },
    "schema_version": {
      "const": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "grade"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "grade": {
            "enum": [
              "deterministic",
              "inferential",
              "human-judgement"
            ]
          }
        }
      }
    }
  }
}
